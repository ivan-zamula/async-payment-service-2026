# Required for both Docker Compose and local API startup.
API_KEY=replace-with-a-random-secret

# Published ports on the host (optional).
API_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672

# Local Python processes and Alembic use these URLs.
# Compose containers connect to postgres/rabbitmq by service name instead.
DATABASE_URL=postgresql+asyncpg://payments:payments@127.0.0.1:5432/payments
RABBITMQ_URL=amqp://payments:payments@127.0.0.1:5672/
